# Database — local MySQL for dev. For prod set the hosted MySQL URL.
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/support_tickets
# Set to true for hosted MySQL that requires TLS (e.g. Aiven). Leave false locally.
DB_SSL=false
# JWT
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# AI
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
# CORS (comma-separated origins for the frontend)
CORS_ORIGINS=http://localhost:5173
